package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "hardened_target",
    srcs: ["src/sandbox_test.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
        "-D_FORTIFY_SOURCE=2",
        "-fstack-protector-strong",
    ],
    sanitize: {
        cfi: true,
        safestack: false, // Incompatible with CFI simultaneously on some arches
    },
    shared_libs: [
        "libbase",
        "liblog",
    ],
}
